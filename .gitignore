# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
# Upload/release signing keys must never be committed — see docs/RELEASE.md.
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Firebase credential files (kept in android/app/ and ios/ which are gitignored above)
/google-services.json
/GoogleService-Info.plist

# Build artifacts — never committed, from any folder (kept locally in release/)
*.apk
*.aab
