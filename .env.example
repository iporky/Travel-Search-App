# Copy to `.env` to override the backend host for local builds.
# Default (no .env): https://staging.konnect.kr — see src/config/index.ts.
# After changing this, run `cd android && ./gradlew clean` before assembleRelease:
# the Gradle JS-bundle task doesn't track .env changes.
EXPO_PUBLIC_API_HOST=https://staging.konnect.kr
